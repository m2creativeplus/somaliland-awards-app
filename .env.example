# Required — Cryptographic secret for session and JWT authentication
PAYLOAD_SECRET=replace-with-a-secure-random-secret-key-32-chars

# Canonical Production URL & CORS
NEXT_PUBLIC_SITE_URL=https://weddings.m2creative.sl
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Localization & Commerce
NEXT_PUBLIC_DEFAULT_LOCALE=so
NEXT_PUBLIC_DEFAULT_CURRENCY=USD

# Database Configuration (Local SQLite for Next.js / Payload)
DATABASE_URL="file:./dev.db"

# Hostinger Shared Hosting Database Credentials (for standalone PHP package)
HOSTINGER_DB_HOST=localhost
HOSTINGER_DB_PORT=3306
HOSTINGER_DB_NAME=your_cpanel_db_name
HOSTINGER_DB_USER=your_cpanel_db_user
HOSTINGER_DB_PASS=your_cpanel_db_password

# Optional: Mail / SMTP Relay
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_USER=noreply@weddings.m2creative.sl
SMTP_PASS=your-smtp-password
SMTP_FROM_EMAIL=noreply@weddings.m2creative.sl
SMTP_FROM_NAME="Somaliland Weddings & Events"

# Optional: Analytics
NEXT_PUBLIC_GA_ID=
